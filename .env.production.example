# PostgreSQL container
POSTGRES_DB=noc_orchestrator
POSTGRES_USER=noc_orchestrator
POSTGRES_PASSWORD=change-me

# App -> PostgreSQL connection. Use the Compose service name `postgres`, not localhost.
DATABASE_URL=postgresql://noc_orchestrator:change-me@postgres:5432/noc_orchestrator

# NOC Orchestrator
APP_PORT=3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://noc.example.com
BETTER_AUTH_TRUSTED_ORIGINS=https://noc.example.com

# Microsoft Entra ID (optional until configured)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
