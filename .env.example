# NOC Orchestrator local development
DATABASE_URL="postgresql://noc_orchestrator:noc_orchestrator_dev@localhost:5433/noc_orchestrator_dev"

# Better Auth
# Generate a strong value before using authentication outside local development.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Microsoft Entra ID (optional until configured)
# All three values must be set before the Microsoft provider is enabled.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
