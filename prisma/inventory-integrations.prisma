// Generic inventory source definitions and sync-profile composition.
//
// Provider identity is deliberately separate from adapter/transport identity.
// AUVIK can therefore retain provider-scoped crosswalks while moving from an
// Auvik XLSX source to a future Auvik API source.
model InventorySource {
  id              String  @id @default(uuid())
  provider        String
  adapterType     String
  sourceAdapterId String
  name            String
  enabled         Boolean @default(true)
  configuration   Json
  metadata        Json?

  profileLinks InventorySyncProfileSource[]
  secret       InventorySourceSecret?
  syncRuns     InventorySyncRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([provider, sourceAdapterId])
  @@index([provider, enabled])
  @@index([adapterType, enabled])
  @@index([name])
}

model InventorySyncProfile {
  id      String  @id @default(uuid())
  name    String  @unique
  enabled Boolean @default(true)

  sources InventorySyncProfileSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([enabled, name])
}

model InventorySyncProfileSource {
  id        String @id @default(uuid())
  profileId String
  sourceId  String
  position  Int    @default(0)

  profile InventorySyncProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  source  InventorySource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([profileId, sourceId])
  @@index([profileId, position])
  @@index([sourceId])
}


/// Encrypted connection credentials for one inventory source.
///
/// The browser-facing InventorySource configuration stays non-secret. The
/// encrypted envelope is decrypted only in server-side integration code using
/// INVENTORY_SOURCE_SECRET_KEY.
model InventorySourceSecret {
  sourceId         String @id
  algorithm        String @default("aes-256-gcm")
  keyVersion       Int    @default(1)
  initializationVector String
  authenticationTag    String
  ciphertext           String

  source InventorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}


/// Durable audit/history record for one manual or scheduled inventory synchronization.
/// Provider adapters never own a separate run-history model.
model InventorySyncRun {
  id        String @id @default(uuid())
  sourceId  String
  trigger   String
  status    String @default("RUNNING")

  batchId             String?
  fetchedCount         Int @default(0)
  stagedCount          Int @default(0)
  autoPublishedCount   Int @default(0)
  reviewRequiredCount  Int @default(0)
  ignoredCount         Int @default(0)
  errorCount           Int @default(0)
  failureSummary       Json?
  errorMessage         String?
  metadata             Json?

  startedAt  DateTime @default(now())
  finishedAt DateTime?

  source InventorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
  @@index([sourceId, status])
  @@index([status, startedAt])
}
