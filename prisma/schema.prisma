generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FirmwareWorkflowState {
  PLANNED
  IGNORED
  CUSTOMER_DECLINED
  DONE
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String?  @default("user")
  banned        Boolean? @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions                   AuthSession[]
  accounts                   AuthAccount[]
  firmwareLifecycleDecisions FirmwareLifecycleRecord[] @relation("LifecycleDecisionActor")
  auditEvents                AuditEvent[]               @relation("AuditEventActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AuthSession {
  id             String   @id @default(uuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String    @id @default(uuid())
  issuer                String
  accountId             String
  providerId             String
  userId                 String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model ContractType {
  id                        String  @id @default(uuid())
  code                      String  @unique
  name                      String  @unique
  description               String?
  firmwareManagementEnabled Boolean @default(true)
  isActive                  Boolean @default(true)

  customers        Customer[]
  sites            Site[]
  firmwarePolicies FirmwarePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
}

model Vendor {
  id         String  @id @default(uuid())
  code       String  @unique
  name       String  @unique
  websiteUrl String?
  isActive   Boolean @default(true)

  deviceModelFamilies DeviceModelFamily[]
  deviceModels        DeviceModel[]
  firmwareTrains      FirmwareTrain[]
  firmwareReleases    FirmwareRelease[]
  firmwarePolicies    FirmwarePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
}

model DeviceType {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  deviceModels     DeviceModel[]
  firmwarePolicies FirmwarePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
}

model DeviceModelFamily {
  id       String  @id @default(uuid())
  vendorId String
  name     String
  notes    String?
  isActive Boolean @default(true)

  vendor           Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  models           DeviceModel[]
  firmwarePolicies FirmwarePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([vendorId, name])
  @@index([vendorId])
  @@index([isActive])
}

model Customer {
  id             String  @id @default(uuid())
  code           String? @unique
  name           String
  contractTypeId String?
  isActive       Boolean @default(true)

  // Inventory provenance. Initial conceptual values are MANUAL, API, and IMPORT.
  source             String   @default("MANUAL")
  externalProvider   String?
  externalId         String?
  lastSynchronizedAt DateTime?
  sourceMetadata     Json?

  contractType     ContractType?   @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  sites            Site[]
  devices          Device[]
  firmwarePolicies FirmwarePolicy[]
  auditEvents      AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([externalProvider, externalId])
  @@index([contractTypeId])
  @@index([source])
  @@index([isActive])
  @@index([name])
}

model Site {
  id             String  @id @default(uuid())
  customerId     String
  contractTypeId String?
  name           String
  code           String?

  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  region       String?
  country      String?
  notes        String?
  isActive     Boolean @default(true)

  // Inventory provenance. Initial conceptual values are MANUAL, API, and IMPORT.
  source             String   @default("MANUAL")
  externalProvider   String?
  externalId         String?
  lastSynchronizedAt DateTime?
  sourceMetadata     Json?

  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contractType     ContractType?    @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  devices          Device[]
  firmwarePolicies FirmwarePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([customerId, code])
  @@index([customerId])
  @@index([contractTypeId])
  @@index([name])
  @@index([source])
  @@index([isActive])
  @@index([externalProvider, externalId])
}

model DeviceModel {
  id           String  @id @default(uuid())
  vendorId     String
  deviceTypeId String
  familyId     String?
  model        String
  platform     String?
  notes        String?
  isActive     Boolean @default(true)

  // Inventory provenance. Initial conceptual values are MANUAL, API, and IMPORT.
  source             String   @default("MANUAL")
  externalProvider   String?
  externalId         String?
  lastSynchronizedAt DateTime?
  sourceMetadata     Json?

  vendor           Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  deviceType       DeviceType         @relation(fields: [deviceTypeId], references: [id], onDelete: Restrict)
  family           DeviceModelFamily? @relation(fields: [familyId], references: [id], onDelete: Restrict)
  devices          Device[]
  firmwarePolicies FirmwarePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([vendorId, model])
  @@index([externalProvider, externalId])
  @@index([vendorId])
  @@index([deviceTypeId])
  @@index([familyId])
  @@index([platform])
  @@index([source])
  @@index([isActive])
}

model FirmwareTrain {
  id       String @id @default(uuid())
  vendorId String
  platform String
  name     String
  notes    String?
  isActive Boolean @default(true)

  // Catalog provenance. Initial conceptual values are MANUAL, API, and IMPORT.
  source             String   @default("MANUAL")
  externalProvider   String?
  externalId         String?
  lastSynchronizedAt DateTime?
  sourceMetadata     Json?

  vendor        Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  releases      FirmwareRelease[]
  policyTargets FirmwarePolicy[] @relation("PolicyFirmwareTrain")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([vendorId])
  @@index([platform])
  @@index([source])
  @@index([isActive])
  @@index([externalProvider, externalId])
}

model FirmwareRelease {
  id              String  @id @default(uuid())
  vendorId        String
  firmwareTrainId String?
  platform        String

  // Exact vendor identity is never collapsed. logicalVersion is only a
  // grouping/comparison aid; variant/imageCode preserve meaningful artifacts.
  version            String
  logicalVersion     String
  variant            String?
  imageCode          String?
  catalogState       String @default("VERIFIED")
  policyEligibility  String @default("NOT_EVALUATED")
  variantEquivalence String @default("EXACT_ONLY")

  filename        String?
  sha256          String?
  fileSizeBytes   BigInt?
  releaseNotesUrl String?

  // Legacy Issue #7 compatibility field. New policy code uses the separate
  // catalogState and policyEligibility fields above.
  status     String  @default("AVAILABLE")
  notes      String?
  releasedAt DateTime?
  isActive   Boolean @default(true)

  // Catalog provenance. Initial conceptual values are MANUAL, API, and IMPORT.
  source             String   @default("MANUAL")
  externalProvider   String?
  externalId         String?
  lastSynchronizedAt DateTime?
  sourceMetadata     Json?

  vendor              Vendor                    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  firmwareTrain       FirmwareTrain?             @relation(fields: [firmwareTrainId], references: [id], onDelete: Restrict)
  currentOnDevices    Device[]                   @relation("DeviceCurrentFirmware")
  targetedByPolicies  FirmwarePolicy[]           @relation("PolicyTargetFirmware")
  minimumForPolicies  FirmwarePolicy[]           @relation("PolicyMinimumFirmware")
  maximumForPolicies  FirmwarePolicy[]           @relation("PolicyMaximumFirmware")
  lifecycleTargets    FirmwareLifecycleRecord[]  @relation("LifecycleTargetFirmware")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([vendorId, platform, version])
  @@index([externalProvider, externalId])
  @@index([vendorId])
  @@index([firmwareTrainId])
  @@index([version])
  @@index([logicalVersion])
  @@index([catalogState])
  @@index([policyEligibility])
  @@index([status])
  @@index([source])
  @@index([isActive])
}

model Device {
  id                        String   @id @default(uuid())
  customerId                String
  siteId                    String?
  deviceModelId             String
  name                      String
  hostname                  String?
  serialNumber              String?
  managementAddress         String?
  notes                     String?
  currentFirmwareReleaseId  String?
  currentFirmwareObservedAt DateTime?
  currentFirmwareSource     String   @default("MANUAL")

  // Exact reported evidence survives even when no compatible canonical release
  // can be linked. Importer #48/#51 can populate these independently.
  currentFirmwareRawVersion         String?
  currentFirmwareNormalizedVersion  String?
  currentFirmwareEvidence           Json?
  currentFirmwareInterpreterId      String?
  currentFirmwareInterpreterVersion String?

  isActive Boolean @default(true)

  // Inventory provenance. Initial conceptual values are MANUAL, API, and IMPORT.
  source             String   @default("MANUAL")
  externalProvider   String?
  externalId         String?
  lastSynchronizedAt DateTime?
  sourceMetadata     Json?

  customer               Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site                   Site?            @relation(fields: [siteId], references: [id], onDelete: Restrict)
  deviceModel            DeviceModel      @relation(fields: [deviceModelId], references: [id], onDelete: Restrict)
  currentFirmwareRelease FirmwareRelease? @relation("DeviceCurrentFirmware", fields: [currentFirmwareReleaseId], references: [id], onDelete: Restrict)
  lifecycle              FirmwareLifecycleRecord?
  firmwarePolicies       FirmwarePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([customerId, name])
  @@index([customerId, serialNumber])
  @@index([externalProvider, externalId])
  @@index([customerId])
  @@index([siteId])
  @@index([deviceModelId])
  @@index([currentFirmwareReleaseId])
  @@index([currentFirmwareSource])
  @@index([source])
  @@index([isActive])
  @@index([hostname])
}

model FirmwarePolicy {
  id String @id @default(uuid())

  // Policy definition. targetFirmwareReleaseId is the preferred exact target
  // when one exists; minimum/maximum form the acceptance window. Moving-train
  // policies use firmwareTrainId and deliberately need no exact preferred row.
  policyMode               String  @default("EXACT")
  minimumFirmwareReleaseId String?
  targetFirmwareReleaseId  String?
  maximumFirmwareReleaseId String?
  firmwareTrainId          String?
  minimumInclusive         Boolean @default(true)
  maximumInclusive         Boolean @default(true)
  desiredPlatform          String?

  // Tracks are explicit policy paths. Multiple tracks may coexist at one scope;
  // exactly one applicable track should normally be marked default.
  trackKey       String  @default("default")
  trackName      String  @default("Default")
  trackClass     String  @default("PREFERRED")
  isDefaultTrack Boolean @default(true)

  // Policy rows are append-oriented versions. A future effectiveFrom does not
  // deactivate the current policy; the resolver selects the newest effective
  // version and leaves both inspectable.
  effectiveFrom DateTime @default(now())
  policyVersion Int      @default(1)
  isActive      Boolean  @default(true)
  notes         String?

  // Policy subject: normally a family baseline, optional concrete-model
  // refinement, or a single device. Customer/Site scope is combined with a
  // family/model subject so organizational overrides remain hardware-specific.
  deviceModelFamilyId String?
  deviceModelId       String?
  customerId          String?
  siteId              String?
  deviceId            String?

  // Retained legacy/secondary scopes. #43 does not assign them precedence over
  // Device > Site > Customer > Model > Family.
  contractTypeId String?
  vendorId       String?
  deviceTypeId   String?

  minimumFirmwareRelease FirmwareRelease?    @relation("PolicyMinimumFirmware", fields: [minimumFirmwareReleaseId], references: [id], onDelete: Restrict)
  targetFirmwareRelease  FirmwareRelease?    @relation("PolicyTargetFirmware", fields: [targetFirmwareReleaseId], references: [id], onDelete: Restrict)
  maximumFirmwareRelease FirmwareRelease?    @relation("PolicyMaximumFirmware", fields: [maximumFirmwareReleaseId], references: [id], onDelete: Restrict)
  firmwareTrain          FirmwareTrain?      @relation("PolicyFirmwareTrain", fields: [firmwareTrainId], references: [id], onDelete: Restrict)
  deviceModelFamily      DeviceModelFamily?  @relation(fields: [deviceModelFamilyId], references: [id], onDelete: Restrict)
  deviceModel            DeviceModel?        @relation(fields: [deviceModelId], references: [id], onDelete: Restrict)
  customer               Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site                   Site?               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  contractType           ContractType?       @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  device                 Device?             @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  vendor                 Vendor?             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  deviceType             DeviceType?         @relation(fields: [deviceTypeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([minimumFirmwareReleaseId])
  @@index([targetFirmwareReleaseId])
  @@index([maximumFirmwareReleaseId])
  @@index([firmwareTrainId])
  @@index([deviceModelFamilyId, isActive, effectiveFrom])
  @@index([deviceModelId, isActive])
  @@index([customerId])
  @@index([customerId, isActive, effectiveFrom])
  @@index([siteId, isActive, effectiveFrom])
  @@index([contractTypeId])
  @@index([deviceId])
  @@index([deviceId, isActive, effectiveFrom])
  @@index([vendorId])
  @@index([deviceTypeId])
  @@index([trackKey, isDefaultTrack, isActive, effectiveFrom])
  @@index([isActive])
}

model FirmwareLifecycleRecord {
  id                      String                @id @default(uuid())
  deviceId                String                @unique
  targetFirmwareReleaseId String
  state                   FirmwareWorkflowState
  reason                  String?
  notes                   String?
  plannedFor              DateTime?
  reviewAt                DateTime?
  decidedAt               DateTime              @default(now())
  decidedByUserId         String?
  completedAt             DateTime?

  device                Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  targetFirmwareRelease FirmwareRelease @relation("LifecycleTargetFirmware", fields: [targetFirmwareReleaseId], references: [id], onDelete: Restrict)
  decidedBy             User?           @relation("LifecycleDecisionActor", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([state])
  @@index([targetFirmwareReleaseId])
  @@index([decidedByUserId])
  @@index([plannedFor])
  @@index([reviewAt])
}

model AuditEvent {
  id          String @id @default(uuid())
  actorUserId String?
  customerId  String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  metadata    Json?

  actor    User?     @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([customerId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// Confirmed, reusable importer configuration. These records contain parsing
// policy only; uploaded inventory rows remain outside the canonical domain.
model ImporterV2SourceProfile {
  id                String  @id @default(uuid())
  name              String
  version           String
  isActive          Boolean @default(true)
  schemaFingerprint String
  provider          String
  sourceAdapterId   String
  sheetName         String
  headerRow         Int
  headers           Json
  columnMappings    Json
  hierarchyTemplate Json
  deviceTypePolicy  Json
  defaults          Json
  exactValueAliases Json

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([provider, name])
  @@index([sourceAdapterId, provider, schemaFingerprint, isActive])
  @@index([isActive, name])
}