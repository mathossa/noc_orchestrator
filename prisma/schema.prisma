generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FirmwareWorkflowState {
  PLANNED
  IGNORED
  CUSTOMER_DECLINED
  DONE
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String?  @default("user")
  banned        Boolean? @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions                   AuthSession[]
  accounts                   AuthAccount[]
  firmwareLifecycleDecisions FirmwareLifecycleRecord[] @relation("LifecycleDecisionActor")
  auditEvents                AuditEvent[]               @relation("AuditEventActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AuthSession {
  id             String   @id @default(uuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String    @id @default(uuid())
  issuer                String
  accountId             String
  providerId             String
  userId                 String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                   String?
  password                String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model ContractType {
  id                        String  @id @default(uuid())
  code                      String  @unique
  name                      String  @unique
  description               String?
  firmwareManagementEnabled Boolean @default(true)
  isActive                  Boolean @default(true)

  customers        Customer[]
  sites            Site[]
  firmwarePolicies FirmwarePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
}

model Vendor {
  id         String  @id @default(uuid())
  code       String  @unique
  name       String  @unique
  websiteUrl String?
  isActive   Boolean @default(true)

  deviceModelFamilies DeviceModelFamily[]
  deviceModels        DeviceModel[]
  firmwareTrains      FirmwareTrain[]
  firmwareReleases    FirmwareRelease[]
  firmwarePolicies    FirmwarePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
}

model DeviceType {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  deviceModels     DeviceModel[]
  firmwarePolicies FirmwarePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
}

model DeviceModelFamily {
  id       String  @id @default(uuid())
  vendorId String
  name     String
  notes    String?
  isActive Boolean @default(true)

  vendor Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  models DeviceModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([vendorId, name])
  @@index([vendorId])
  @@index([isActive])
}

model Customer {
  id             String  @id @default(uuid())
  code           String? @unique
  name           String
  contractTypeId String?
  isActive       Boolean @default(true)

  source             String   @default("MANUAL")
  externalProvider   String?
  externalId         String?
  lastSynchronizedAt DateTime?
  sourceMetadata     Json?

  contractType     ContractType?   @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  sites            Site[]
  devices          Device[]
  firmwarePolicies FirmwarePolicy[]
  auditEvents      AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([externalProvider, externalId])
  @@index([contractTypeId])
  @@index([source])
  @@index([isActive])
  @@index([name])
}

model Site {
  id             String  @id @default(uuid())
  customerId     String
  contractTypeId String?
  name           String
  code           String?

  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  region       String?
  country      String?
  notes        String?
  isActive     Boolean @default(true)

  source             String   @default("MANUAL")
  externalProvider   String?
  externalId         String?
  lastSynchronizedAt DateTime?
  sourceMetadata     Json?

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contractType ContractType? @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  devices      Device[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([customerId, code])
  @@index([customerId])
  @@index([contractTypeId])
  @@index([name])
  @@index([source])
  @@index([isActive])
  @@index([externalProvider, externalId])
}

model DeviceModel {
  id           String  @id @default(uuid())
  vendorId     String
  deviceTypeId String
  familyId     String?
  model        String
  platform     String?
  notes        String?
  isActive     Boolean @default(true)

  source             String   @default("MANUAL")
  externalProvider   String?
  externalId         String?
  lastSynchronizedAt DateTime?
  sourceMetadata     Json?

  vendor           Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  deviceType       DeviceType         @relation(fields: [deviceTypeId], references: [id], onDelete: Restrict)
  family           DeviceModelFamily? @relation(fields: [familyId], references: [id], onDelete: Restrict)
  devices          Device[]
  firmwarePolicies FirmwarePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([vendorId, model])
  @@index([externalProvider, externalId])
  @@index([vendorId])
  @@index([deviceTypeId])
  @@index([familyId])
  @@index([platform])
  @@index([source])
  @@index([isActive])
}

model DeviceImportProfile {
  id               String  @id @default(uuid())
  name             String  @unique
  externalProvider String?
  settings         Json
  isActive         Boolean @default(true)
  aliases          DeviceImportProfileAlias[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
  @@index([externalProvider])
}

model DeviceImportProfileAlias {
  id                    String @id @default(uuid())
  profileId             String
  kind                  String
  sourceValue           String
  normalizedSourceValue String
  contextKey            String @default("")
  targetId              String

  profile DeviceImportProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([profileId, kind, normalizedSourceValue, contextKey])
  @@index([profileId])
  @@index([kind, targetId])
}

model ImportReferenceAlias {
  id                    String @id @default(uuid())
  kind                  String
  sourceValue           String
  normalizedSourceValue String
  contextKey            String @default("")
  targetId              String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([kind, normalizedSourceValue, contextKey])
  @@index([kind, targetId])
}

model FirmwareTrain {
  id       String @id @default(uuid())
  vendorId String
  platform String
  name     String
  notes    String?
  isActive Boolean @default(true)

  source             String   @default("MANUAL")
  externalProvider   String?
  externalId         String?
  lastSynchronizedAt DateTime?
  sourceMetadata     Json?

  vendor   Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  releases FirmwareRelease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([vendorId])
  @@index([platform])
  @@index([source])
  @@index([isActive])
  @@index([externalProvider, externalId])
}

model FirmwareRelease {
  id              String  @id @default(uuid())
  vendorId        String
  firmwareTrainId String?
  platform        String
  version         String
  filename        String?
  sha256          String?
  fileSizeBytes   BigInt?
  releaseNotesUrl String?
  status          String  @default("AVAILABLE")
  notes           String?
  releasedAt      DateTime?
  isActive        Boolean @default(true)

  source             String   @default("MANUAL")
  externalProvider   String?
  externalId         String?
  lastSynchronizedAt DateTime?
  sourceMetadata     Json?

  vendor             Vendor                    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  firmwareTrain      FirmwareTrain?             @relation(fields: [firmwareTrainId], references: [id], onDelete: Restrict)
  currentOnDevices   Device[]                  @relation("DeviceCurrentFirmware")
  targetedByPolicies FirmwarePolicy[]          @relation("PolicyTargetFirmware")
  lifecycleTargets   FirmwareLifecycleRecord[] @relation("LifecycleTargetFirmware")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([vendorId, platform, version])
  @@index([externalProvider, externalId])
  @@index([vendorId])
  @@index([firmwareTrainId])
  @@index([version])
  @@index([status])
  @@index([source])
  @@index([isActive])
}

model Device {
  id                        String   @id @default(uuid())
  customerId                String
  siteId                    String?
  deviceModelId             String
  name                      String
  hostname                  String?
  serialNumber              String?
  managementAddress         String?
  notes                     String?
  currentFirmwareReleaseId  String?
  currentFirmwareObservedAt DateTime?
  currentFirmwareSource     String   @default("MANUAL")
  isActive                  Boolean  @default(true)

  source             String   @default("MANUAL")
  externalProvider   String?
  externalId         String?
  lastSynchronizedAt DateTime?
  sourceMetadata     Json?

  customer               Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site                   Site?            @relation(fields: [siteId], references: [id], onDelete: Restrict)
  deviceModel            DeviceModel      @relation(fields: [deviceModelId], references: [id], onDelete: Restrict)
  currentFirmwareRelease FirmwareRelease? @relation("DeviceCurrentFirmware", fields: [currentFirmwareReleaseId], references: [id], onDelete: Restrict)
  lifecycle              FirmwareLifecycleRecord?
  firmwarePolicies       FirmwarePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([customerId, name])
  @@index([customerId, serialNumber])
  @@index([externalProvider, externalId])
  @@index([customerId])
  @@index([siteId])
  @@index([deviceModelId])
  @@index([currentFirmwareReleaseId])
  @@index([currentFirmwareSource])
  @@index([source])
  @@index([isActive])
  @@index([hostname])
}

model FirmwarePolicy {
  id                      String  @id @default(uuid())
  targetFirmwareReleaseId String
  isActive                Boolean @default(true)
  notes                   String?

  deviceModelId  String?
  customerId     String?
  contractTypeId String?
  deviceId       String?
  vendorId       String?
  deviceTypeId   String?

  targetFirmwareRelease FirmwareRelease @relation("PolicyTargetFirmware", fields: [targetFirmwareReleaseId], references: [id], onDelete: Restrict)
  deviceModel           DeviceModel?    @relation(fields: [deviceModelId], references: [id], onDelete: Restrict)
  customer              Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contractType          ContractType?   @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  device                Device?         @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  vendor                Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  deviceType            DeviceType?     @relation(fields: [deviceTypeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([targetFirmwareReleaseId])
  @@index([deviceModelId, isActive])
  @@index([customerId])
  @@index([contractTypeId])
  @@index([deviceId])
  @@index([vendorId])
  @@index([deviceTypeId])
  @@index([isActive])
}

model FirmwareLifecycleRecord {
  id                      String                @id @default(uuid())
  deviceId                String                @unique
  targetFirmwareReleaseId String
  state                   FirmwareWorkflowState
  reason                  String?
  notes                   String?
  plannedFor              DateTime?
  reviewAt                DateTime?
  decidedAt               DateTime              @default(now())
  decidedByUserId         String?
  completedAt             DateTime?

  device                Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  targetFirmwareRelease FirmwareRelease @relation("LifecycleTargetFirmware", fields: [targetFirmwareReleaseId], references: [id], onDelete: Restrict)
  decidedBy             User?           @relation("LifecycleDecisionActor", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([state])
  @@index([targetFirmwareReleaseId])
  @@index([decidedByUserId])
  @@index([plannedFor])
  @@index([reviewAt])
}

model AuditEvent {
  id          String @id @default(uuid())
  actorUserId String?
  customerId  String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  metadata    Json?

  actor    User?     @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([customerId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
