// Issue #57: vendor-neutral firmware compatibility evidence and reversible
// manual overrides. Policy preference remains owned by FirmwarePolicy.
model FirmwareCompatibilityRule {
  id                    String   @id @default(uuid())
  vendorId              String
  deviceModelFamilyId   String?
  deviceModelId         String?
  platform              String
  firmwareTrainId       String?
  logicalVersion        String?
  firmwareReleaseId     String?
  imageCode             String?
  decision              String   @default("ALLOW")
  sourceType            String   @default("CATALOG")
  explanation           String
  notes                 String?
  isActive              Boolean  @default(true)
  validFrom             DateTime?
  validUntil            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  @@index([vendorId, isActive], map: "FwCompatRule_vendor_active_idx")
  @@index([deviceModelFamilyId, isActive], map: "FwCompatRule_family_active_idx")
  @@index([deviceModelId, isActive], map: "FwCompatRule_model_active_idx")
  @@index([platform, isActive], map: "FwCompatRule_platform_active_idx")
  @@index([firmwareTrainId], map: "FwCompatRule_train_idx")
  @@index([logicalVersion], map: "FwCompatRule_logical_version_idx")
  @@index([firmwareReleaseId], map: "FwCompatRule_release_idx")
  @@index([imageCode], map: "FwCompatRule_image_code_idx")
  @@index([sourceType, isActive], map: "FwCompatRule_source_active_idx")
}

model FirmwareCompatibilityOverride {
  id                String   @id @default(uuid())
  deviceModelId     String
  firmwareReleaseId String
  decision          String
  reason            String
  version           Int      @default(1)
  isActive          Boolean  @default(true)
  createdByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([deviceModelId, firmwareReleaseId, version], map: "FwCompatOverride_model_release_version_key")
  @@index([deviceModelId, firmwareReleaseId, isActive], map: "FwCompatOverride_model_release_active_idx")
  @@index([createdByUserId], map: "FwCompatOverride_actor_idx")
}
