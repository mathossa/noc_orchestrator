{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "noEmit": false,
    "incremental": false,
    "outDir": ".worker-dist",
    "rootDir": "."
  },
  "include": ["scripts/background-worker.ts", "scripts/job-demo.ts", "src/jobs/**/*.ts"],
  "exclude": ["node_modules", ".next", ".worker-dist", "**/*.test.ts"]
}
